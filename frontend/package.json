    "immer": "^10.1.1",
    "marked": "^15.0.11",
    "motion": "^12.7.4",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-firebase-hooks": "^5.1.1",
